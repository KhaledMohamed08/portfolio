---
import { SITE } from "../data/site";
---

<footer class="border-t border-term-border py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="text-xs text-term-fg-muted font-mono">
      <span class="text-term-green">{SITE.name.toLowerCase()}@portfolio</span>
      <span class="mx-1">:</span>
      <span class="text-term-blue">~</span>
      <span class="mx-1">$</span>
      <span class="text-term-fg-muted">Built with Astro & Tailwind</span>
    </div>
    <div class="term-status-bar">
      <span class="term-status-dot"></span>
      <span id="sys-uptime">SYSTEM: ONLINE</span>
      <span class="hidden sm:inline">|</span>
      <span class="hidden sm:inline">{SITE.email}</span>
      <span class="hidden sm:inline">|</span>
      <span class="hidden sm:inline">&copy; {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>

<script>
  const start = Date.now();
  function updateUptime() {
    const seconds = Math.floor((Date.now() - start) / 1000);
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const el = document.getElementById("sys-uptime");
    if (el) el.textContent = `UPTIME: ${d}d ${h}h ${m}m`;
  }
  updateUptime();
  setInterval(updateUptime, 10000);
</script>