---
export interface Props {
  id: string;
  title: string;
  description: string;
  maxWidth?: "4xl" | "6xl";
  class?: string;
}

const { id, title, description, maxWidth = "6xl" } = Astro.props;
const containerClass = maxWidth === "4xl" ? "max-w-4xl" : "max-w-6xl";
---

<section id={id} class="relative py-24 sm:py-32 reveal {Astro.props.class}">
  <div class="relative z-10 {containerClass} mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12">
      <div class="text-xs text-term-fg-muted mb-1">
        <span class="text-term-green">┌──(</span>
        <span class="text-term-yellow"># {id}</span>
        <span class="text-term-green">)</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-term-fg" style="font-family: var(--font-mono);">{title}</h2>
      <p class="mt-2 text-xs text-term-fg-muted">{description}</p>
    </div>
    <slot />
  </div>
</section>